flowchart TD
  classDef llm stroke-width:2px
  classDef agent stroke-width:2px
  classDef write stroke-width:1px
  classDef send stroke-width:2px
  classDef spend stroke-width:2px
  classDef succeeded stroke-width:3px
  classDef failed stroke-width:3px,stroke-dasharray:4 2
  classDef running stroke-width:3px
  classDef waiting stroke-width:3px,stroke-dasharray:2 2
  classDef skipped stroke-width:1px
  classDef mocked stroke-width:2px,stroke-dasharray:1 3
  n_start(["trigger · schedule<br/>0 8 * * 1-5"])
  n_fetch["tool · calendar-bookings-list<br/>read · 3 attempts max"]
  subgraph n_each ["loop · for each b · max 200"]
    direction TB
    n_classify{{"LLM · classify<br/>model default · 1 iteration · $0.01 cap"}}
    n_upsert_one["MCP · crm.upsert_contact<br/>write"]
  end
  n_upsert{"check · 1 assert<br/>on fail: repair"}
  n_notify["MCP · slack.post_message<br/>SEND · owner-approved v3"]
  n_done(["end"])
  n_start --> n_fetch
  n_fetch --> n_each
  n_classify --> n_upsert_one
  n_each --> n_upsert
  n_upsert --> n_notify
  n_notify --> n_done
  class n_classify llm
  class n_upsert_one write
  class n_notify send
