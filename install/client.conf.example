# ==============================================================================
# Operation Kit — client settings
# ------------------------------------------------------------------------------
# ONE file per client install. Copy it, fill it in, then run the installer:
#
#   cp install/client.conf.example client.conf
#   sudo ./install.sh --config client.conf
#
# Rules for this file:
#   * Plain KEY="value" lines. Nothing else is run — the installer READS this
#     file, it does not execute it.
#   * NO passwords, API keys or tokens go in here. Every secret is generated on
#     the server (or handed over in a separate file that is deleted after use —
#     see INSTALL.md, "Handing over the Cloudflare token").
#   * Lines starting with # are comments.
# ==============================================================================

# ── Who the install is for ────────────────────────────────────────────────────
# Shown in the browser tab, the sign-in page and the top-left of the app.
CLIENT_NAME="Example Capital Partners"

# Short id, lowercase letters / digits / dashes. Used for the first workspace,
# the Cloudflare tunnel name and the Access application name.
CLIENT_SLUG="example-capital"

# ── Web address ───────────────────────────────────────────────────────────────
# The full address people will type. Must be a sub-domain of a domain that is
# already on the client's Cloudflare account (ZONE below). DOMAIN, ZONE and the
# ACCESS_* settings may be left empty for a local-only test install
# (./install.sh --skip-cloudflare, reached over an SSH tunnel).
DOMAIN="ops.example-capital.com"

# The Cloudflare zone (the bare domain) that DOMAIN lives under.
ZONE="example-capital.com"

# ── Branding ──────────────────────────────────────────────────────────────────
# Product name shown in the app. Leave as-is to keep "Operation Kit".
BRAND_NAME="Operation Kit"

# Optional logo: a path on the SERVER (copied in by the installer) to a square
# PNG or SVG, at most 512 KB. Leave empty for the default mark.
BRAND_LOGO=""

# ── Fallback git identity ─────────────────────────────────────────────────────
# Agent commits normally carry the card owner's own GitHub identity (Settings →
# Connectors → GitHub). When the owner has not connected GitHub, commits use
# this identity instead: the client's own bot or operator GitHub account. Use
# its GitHub noreply address (Settings → Emails on github.com, e.g.
# 12345+acme-bot@users.noreply.github.com) so hosts such as Vercel can match it.
# Leave both empty to have no fallback: a commit by an owner without GitHub then
# fails with a "connect GitHub in Settings" message instead.
FALLBACK_GIT_NAME=""
FALLBACK_GIT_EMAIL=""

# ── First administrator ───────────────────────────────────────────────────────
# Username for the first admin account. The installer creates it with a
# one-time setup password; the first sign-in is forced to choose a new one.
ADMIN_USERNAME="admin"

# The first admin's email. Behind Cloudflare Access, whoever signs in at the
# Cloudflare door with THIS email lands in the app as the admin — no second
# sign-in. Leave empty to use the first address in ACCESS_ALLOWED_EMAILS.
# Other people get linked later in Settings → Users (their sign-in email).
ADMIN_EMAIL=""

# ── Who may open the site (Cloudflare Access) ─────────────────────────────────
# Nobody reaches the sign-in page unless Cloudflare Access lets them through.
# Comma-separated list of exact email addresses. This name-by-name list is the
# default: only the people listed here (plus the teammates an admin adds later
# in Settings → Users, see below) ever see the site at all.
ACCESS_ALLOWED_EMAILS="alex.partner@example-capital.com"
# … and/or a whole email domain (everyone @example-capital.com). Optional, and
# left empty by default. Neither the installer nor the app ever adds a domain
# rule on its own; only a value you type here does.
ACCESS_ALLOWED_EMAIL_DOMAIN=""

# Adding teammates later: once the install is up, an admin adds people in
# Settings → Users. Cloudflare Access is a SECOND door in front of the app, so
# a new teammate is still turned away until their email is on the Access list
# too. The way to make that automatic is the Cloudflare sign-in sync token: a
# Cloudflare token with ONE permission (Account → Access: Apps and Policies →
# Edit). The client's admin pastes it into Settings → Users → Cloudflare
# sign-in sync (stored encrypted, never shown again, no restart), or you hand
# it over at install time as CLOUDFLARE_ACCESS_SYNC_TOKEN in the hand-over
# file. With it, the app adds the one address when the user is created and
# takes it out again when the user is deleted. It only ever touches THIS
# install's own "Allowed people" policy, never the addresses listed above, and
# never a domain rule.
# Without that token nothing breaks: Settings → Users simply shows each new
# person as "blocked at Cloudflare" until someone adds them in the dashboard.

# How people prove who they are at the Cloudflare door:
#   otp        — a one-time code is emailed to them (works everywhere, no setup)
#   google     — "Sign in with Google" (needs GOOGLE_* values in the secrets file)
#   microsoft  — "Sign in with Microsoft" (needs AZURE_* values in the secrets file)
ACCESS_LOGIN_METHOD="otp"

# How long one Cloudflare sign-in lasts before asking again.
ACCESS_SESSION_DURATION="24h"

# Let bots reach the board API with their Operation Kit key ("on", the default).
# The installer adds a second, path-limited Access app that steps aside on the
# bot-facing API routes only (install/api-bypass-paths.conf) so the key is what
# decides. Operator routes — /api/internal, /api/admin, /api/secrets,
# /api/secret-upload, /api/webhooks, the rest of /api/auth — always stay behind
# the Cloudflare sign-in. "off" means bots get the sign-in page instead of an
# answer; only turn it off if no bot or AI tool will ever call this install.
API_KEY_AUTH_BYPASS="on"

# Stop Cloudflare's Browser Integrity Check from refusing your own API calls
# ("on", the default). Browser Integrity Check turns away anything that does not
# look like a browser, so a bot holding a perfectly good Operation Kit key gets
# Cloudflare error 1010 (HTTP 403, an HTML page) instead of an answer — even
# with API_KEY_AUTH_BYPASS="on", because that is a different layer. The
# installer adds ONE Cloudflare Configuration Rule that switches the check off
# for this install's own hostname under /api/ and nothing else. Your zone-wide
# Browser Integrity Check setting, your WAF rules, your rate limits and your
# other Configuration Rules are not touched. "off" skips the step.
API_BROWSER_INTEGRITY_EXCEPTION="on"

# ── AI accounts ───────────────────────────────────────────────────────────────
# How the server's worker sessions sign in to Claude:
#   login    — a Claude subscription (Pro / Max / Team). Someone signs in once in
#              a browser during setup (INSTALL.md step 7). Recommended.
#   api-key  — an Anthropic API key, billed per use. Handed over in the secrets
#              file as ANTHROPIC_API_KEY; never typed into this file.
CLAUDE_AUTH="login"

# Optional extra model providers, comma-separated: openai, gemini.
# Their keys go in the secrets file (OPENAI_API_KEY / GEMINI_API_KEY).
EXTRA_PROVIDERS=""

# ── Agents ────────────────────────────────────────────────────────────────────
# Which agents appear on the board. Comma-separated, from:
#   general, cto, cmo, coo, cfo
AGENTS_ENABLED="general,coo,cfo"

# ── Starter packs ─────────────────────────────────────────────────────────────
# Ready-made bundles of agents + sample data, switched on after the first boot.
# Comma-separated pack ids (folders under app/server/src/starter-packs/). If a
# pack cannot be switched on the install stops with the reason (re-run after
# fixing it). Leave empty for none.
STARTER_PACKS="knowledge-import"

# ── Backups ───────────────────────────────────────────────────────────────────
# A backup runs every night at BACKUP_TIME (server time zone) into
# INSTALL_DIR/backups on this server (the last BACKUP_KEEP_LOCAL kept). Set
# BACKUP_TARGET to ALSO copy it, encrypted, off the server — strongly
# recommended: a backup on the same disk does not survive losing the server.
#   Backblaze B2 (S3 API): s3:https://s3.us-west-004.backblazeb2.com/<bucket>/<folder>
#   Any S3-compatible:     s3:https://<endpoint>/<bucket>/<folder>
#   Backblaze B2 (native): b2:<bucket>:<folder>
# Its two keys go in the secrets hand-over file, never here:
# BACKUP_ACCESS_KEY_ID and BACKUP_SECRET_ACCESS_KEY (INSTALL.md, "Backups").
# Easiest way to fill BACKUP_TARGET and hand over the keys for B2: run
#   sudo bash install/b2-setup.sh --config client.conf
# in your own terminal (install.sh offers it at the end of an interactive run).
BACKUP_TARGET=""
BACKUP_TIME="03:30"
BACKUP_KEEP_LOCAL="7"
# How many off-server copies restic keeps (BACKUP_TARGET only): one per day for
# the last BACKUP_KEEP_DAILY days, one per week for BACKUP_KEEP_WEEKLY weeks, one
# per month for BACKUP_KEEP_MONTHLY months. About 17 snapshots with the defaults.
BACKUP_KEEP_DAILY="7"
BACKUP_KEEP_WEEKLY="4"
BACKUP_KEEP_MONTHLY="6"
# How state/home (projects, notes, agent memory, the knowledge base) is kept.
#   archive  every nightly folder holds home.tar.gz (fine up to a few GB)
#   offsite  with BACKUP_TARGET set: home goes to restic as a folder in its own
#            snapshot, so only what changed uploads each night, and the local
#            nightly folders stay small. For a large home (tens of GB). A run
#            that sends nothing off-site still writes home.tar.gz.
BACKUP_HOME="archive"

# ── Server ────────────────────────────────────────────────────────────────────
# Where everything is stored on the server. Change only if the client asks.
INSTALL_DIR="/opt/operationkit"

# Wall-clock time zone for schedules (e.g. America/New_York, Europe/London).
TIMEZONE="America/New_York"

# Per-session sandbox. Leave on "docker" for client installs: every AI session
# runs in its own locked-down container that can only see its own work folder.
SESSION_ISOLATION="docker"

# The app never holds the host Docker socket: a policy sidecar (docker-proxy)
# does, and it only lets the app start and manage locked-down sandboxes. The one
# privileged thing it can allow is the Operation Kit Dev bot's deploy and
# Cloudflare tools (dev_deploy, cloudflare_*), which run install/update.sh on the
# host. Leave "off" unless you use those tools on this server; "on" allows only
# the exact script this checkout ships, with this install's own paths.
HOST_RUNNER="off"

# Size of each sandbox's in-memory /tmp. Leave at "2g": the old 256m filled up
# when an AI review cloned a large repo. It only uses RAM for what is written.
JAIL_TMP_SIZE="2g"

# Put Claude's scratch files on disk (the sandbox's own home folder) instead of
# the in-memory /tmp. Leave empty for off; "on" to enable.
JAIL_CLAUDE_TMPDIR=""

# Address sandboxes use to reach the app from the default Docker bridge. Leave
# empty: the installer detects docker0's gateway (normally 172.17.0.1). Must be a
# private address — the app is never published on the server's public address.
DOCKER_BRIDGE_IP=""

# ── Card browser (Playwright / Chromium) ──────────────────────────────────────
# Review and QA sessions drive a real Chromium to look at pages. That browser
# runs inside the app's container, so a hostile page that breaks out of it would
# land next to the secrets store and the AI seat logins. Three controls keep it
# boxed in; all three are ON by default and you normally change none of them.
#
# Out of the box the browser may open: this install's own site (DOMAIN above),
# and anything on localhost (the preview servers sessions start). EVERYTHING
# else — including the cloud metadata address and the rest of your private
# network — is refused, and the refusal is written to the app's log.
#
# Add the extra sites your team's reviews need, separated by semicolons. A
# leading *. matches sub-domains. Examples:
#   BROWSER_ALLOWED_ORIGINS="https://*.vercel.app;https://staging.example.com"
BROWSER_ALLOWED_ORIGINS=""

# Sites to refuse even if one of the rules above would otherwise allow them.
# Checked first, so it always wins.
BROWSER_BLOCKED_ORIGINS=""

# Let the browser reach other machines on this server's private network
# (10.x, 192.168.x, 172.16-31.x). "off" is the default and the safe answer: turn
# it on only if your reviews have to open an internal staging host by its
# private address, and prefer listing that one host in BROWSER_ALLOWED_ORIGINS.
BROWSER_ALLOW_PRIVATE_NETWORK="off"

# Let the browser open http://localhost:… ("on", the default). Sessions start
# local preview servers and screenshot them, so turning this off disables
# preview review. Turn it off only on an install that never previews locally.
BROWSER_ALLOW_LOOPBACK="on"

# Keep Chromium's own operating-system sandbox on ("on", the default). This is
# the thing that stops a compromised web page from becoming a compromised
# container. Do not turn it off. If the browser will not start, fix the host
# (the installer's checks tell you how) rather than switching this off.
BROWSER_SANDBOX="on"
